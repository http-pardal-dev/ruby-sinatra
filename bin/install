#!/usr/bin/env sh
#
# install - installs the dependencies declared in the Gemfile.
#
# This is the only command of the interface that knows how the dependencies are
# installed: `bin/setup` calls it when they are missing, so there is a single
# place to change when the installation changes.
#
# The installation is `bundle install`, which is idempotent: with everything
# already in place it changes nothing.
#
# Exit codes: 0 success, 1 error while running, 2 invalid usage.

set -e

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

usage() {
  cat <<EOF
Usage: bin/install [options]

Installs the dependencies declared in the Gemfile.

Options:
  -h, --help   Shows this message

Run bin/help to see the commands.
EOF
}

fail() {
  printf 'Error: %s\n' "$1" >&2
  exit 1
}

step() {
  printf '\n==> %s\n' "$1"
}

for argument in "$@"; do
  case "$argument" in
    -h | --help) usage; exit 0 ;;
    *) printf 'Error: invalid usage: %s\n' "$argument" >&2; exit 2 ;;
  esac
done

command -v bundle > /dev/null 2>&1 ||
  fail "Bundler not found. Install it with: gem install bundler"

step "Installing the dependencies (bundle install)"

bundle install || fail "\`bundle install\` failed. Review the Gemfile and try again."

printf '    Dependencies installed.\n'
