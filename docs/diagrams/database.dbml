// database.dbml
//
// Schema of the API implemented by this project. Mirrors db/migrate,
// db/schema.rb and contract/database.sql: three independent resources with no
// relations between them. Dialect: SQLite (see data/database.yml).

Project {
  name: 'HTTP Pardal'
  database_type: 'SQLite'
  note: 'JSON API with three resources: users (CRUD), products (queries) and payments (lifecycle). No foreign keys: the tables are independent.'
}

Enum payment_status {
  pending
  paid
  cancelled
}

Table users {
  id integer [primary_key, increment, note: 'autoincrement']
  name varchar [not null, note: '2-100 chars']
  email varchar [not null, unique, note: 'max 254 chars; stored stripped and lowercased']
  password_digest varchar [not null, note: 'bcrypt digest; `password` and `password_confirmation` are virtual attributes and have no column']
  role varchar [not null, default: 'user', note: 'in [user, admin]']
  active boolean [not null, default: true]
  birthdate date [note: 'nullable; never in the future']
  created_at datetime [not null]
  updated_at datetime [not null]

  indexes {
    email [unique]
  }

  note: 'Users resource — CRUD and HTTP fundamentals. Uniqueness of email is enforced by validation (400) and by the unique index (409 on a race).'
}

Table products {
  id integer [primary_key, increment, note: 'autoincrement; tie-breaker of every sort']
  name varchar [not null, note: '2-100 chars']
  description text [note: 'nullable; max 1000 chars']
  category varchar [not null, note: '2-50 chars']
  price decimal(10,2) [not null, note: '0 to 99999999.99; serialized to the client as text, never as a JSON number']
  created_at datetime [not null]
  updated_at datetime [not null]

  note: 'Products resource — queries: filters, sorting, pagination and partial update.'
}

Table payments {
  id integer [primary_key, increment, note: 'autoincrement']
  amount decimal(10,2) [not null, note: 'greater than 0 and at most 99999999.99; serialized as text']
  status varchar [not null, default: 'pending', note: "enum: pending, paid, cancelled; starts 'pending' and may leave it exactly once (confirm -> paid, cancel -> cancelled); no other transition"]
  created_at datetime [not null]
  updated_at datetime [not null, note: 'refreshed by every transition']

  note: 'Payments resource — lifecycle: states, actions, transitions, headers and idempotency.'
}
