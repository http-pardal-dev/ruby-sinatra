#!/usr/bin/env sh
#
# help - shows the commands of the server and the help of each one.
#
# Without a command the help is the list of every command; with a command it is
# the help of that command, the same as `bin/<command> --help`. That keeps a
# single place to start from, without depending on external documentation.
#
# Exit codes: 0 success, 1 error while running, 2 invalid usage.

set -e

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

# Every command of the server, in the order of the list below.
commands="setup start install snapshot reset help"

usage() {
  cat <<EOF
Usage: bin/help [command]

Shows the commands of the server. With a command, shows the help of that
command, the same as bin/<command> --help.

Commands:
  setup      Prepares the initial environment
  start      Runs the application
  install    Installs the dependencies of the project
  snapshot   Saves a restoration point of the environment
  reset      Restores the snapshot of the environment
  help       Shows this list

Every command also explains itself with --help. Exit codes: 0 success,
1 error while running, 2 invalid usage.
EOF
}

fail() {
  printf 'Error: %s\n' "$1" >&2
  exit 1
}

invalid_usage() {
  printf 'Error: invalid usage: %s\n' "$1" >&2
  exit 2
}

# True when the argument is one of the commands. The variable cannot be called
# `name`: shell functions share variables, and the caller is about to read its
# own.
is_command() {
  for command_name in $commands; do
    if [ "$1" = "$command_name" ]; then
      return 0
    fi
  done

  return 1
}

# Without arguments, the list of commands.
if [ "$#" -eq 0 ]; then
  usage
  exit 0
fi

# `bin/help --help` (or -h) is the same list; anything else with a flag first
# is an invalid usage.
case "$1" in
  -h | --help)
    [ "$#" -eq 1 ] || invalid_usage "$*"
    usage
    exit 0
    ;;
  -*)
    invalid_usage "$*"
    ;;
esac

# One command, optionally followed by the help flags every command accepts.
[ "$#" -le 2 ] || invalid_usage "$*"

if [ "$#" -eq 2 ]; then
  case "$2" in
    -h | --help) ;;
    *) invalid_usage "$*" ;;
  esac
fi

if ! is_command "$1"; then
  printf 'Error: unknown command: %s\n' "$1" >&2
  printf 'Run bin/help to see the commands.\n' >&2
  exit 2
fi

[ -f "$root/bin/$1" ] || fail "bin/$1 not found in $root."

# The help of a command is the own --help of that command, so there is only one
# place where the options are described.
exec sh "$root/bin/$1" --help
