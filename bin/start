#!/usr/bin/env sh
#
# start - starts the server.
#
# The command says what the server has to do - start it - and not how. This
# implementation starts Puma; another one could start Uvicorn, Node or a
# compiled binary and the command would stay exactly the same, which is what
# lets every server of the project offer the same `bin/start`.
#
# The server runs in the foreground, so the terminal keeps showing its output
# (the `development` environment logs every request) and Ctrl+C stops it.
#
# Exit codes: 0 success, 1 error while running, 2 invalid usage.

set -e

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

usage() {
  cat <<EOF
Usage: bin/start [options]

Starts the HTTP server.

Options:
  -h, --help   Shows this message
EOF
}

fail() {
  printf 'Error: %s\n' "$1" >&2
  exit 1
}

for argument in "$@"; do
  case "$argument" in
    -h | --help) usage; exit 0 ;;
    *) printf 'Error: invalid usage: %s\n' "$argument" >&2; exit 2 ;;
  esac
done

bundle check > /dev/null 2>&1 ||
  fail "The dependencies are not installed. Run bin/setup to prepare the environment."

printf '\n==> Starting the server (Puma on http://localhost:9292)\n'
printf '    Press Ctrl+C to stop.\n\n'

# `exec` replaces the process, and a buffered message would go with it. It also
# makes Ctrl+C reach the server directly, without the command in between holding
# the signal.
exec bundle exec puma