#!/usr/bin/env sh
#
# snapshot - saves a restoration point of the environment.
#
# The snapshot is a copy of the whole environment - code, configuration and
# databases - and not only of the database. That is what allows changing,
# deleting and breaking any file without fear: `bin/reset` brings everything
# back.
#
#   .snapshot/
#   |-- created_at     # when the snapshot was saved
#   `-- (the copy)     # code, configuration and databases
#
# The first snapshot is saved by `bin/setup`, when there is none yet. This
# command is for the moments that deserve a point of their own, and it never
# replaces a snapshot that already exists unless `--force` says so: the
# snapshot belongs to the user, and replacing it silently would make `reset`
# take the environment back to a state that was already left behind.
#
# The server must be stopped before the copy is made: while it runs, the database
# files are open and can change under the copy, and the snapshot would be of a
# database that never existed.
#
# Exit codes: 0 success, 1 error while running, 2 invalid usage.

set -e

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

# Folder of the project that keeps the snapshot.
directory=".snapshot"

# What is left out of the snapshot: `.git` and `.snapshot` would be copied
# forever, and the rest are tools of the user, which do not belong to the
# environment and must not be deleted by the reset.
excluded=".git .snapshot .idea .vscode .DS_Store Thumbs.db"

usage() {
  cat <<EOF
Usage: bin/snapshot [options]

Saves a restoration point of the environment in $directory/.

Options:
  -f, --force   Replaces the snapshot that already exists
  -h, --help    Shows this message

The server must be stopped. Run bin/help to see the commands.
EOF
}

fail() {
  printf 'Error: %s\n' "$1" >&2
  exit 1
}

step() {
  printf '\n==> %s\n' "$1"
}

is_excluded() {
  # The name of the entry cannot be used here: shell functions share variables,
  # and it would overwrite what the caller is about to look at.
  for excluded_name in $excluded; do
    if [ "$1" = "$excluded_name" ]; then
      return 0
    fi
  done

  return 1
}

# The ports a server of this project may be answering on: the one used during
# development (`bin/start`, see config/puma.rb) and the one used by the
# end-to-end tests (`bin/test`). Both keep the databases open, so both make the
# copy unsafe.
ports_of_servers() {
  printf '%s %s\n' "${PORT:-9292}" "${E2E_PORT:-9393}"
}

# True when a server answers on `port`. The check asks the port instead of
# looking for the process: any answer means somebody is using these files, which
# is exactly what has to be ruled out, and the answer does not depend on how the
# server was started (foreground, background, another terminal, another
# machine-local shell).
port_in_use() {
  curl -s -o /dev/null --max-time 2 "http://127.0.0.1:$1/" 2>/dev/null
}

# Refuses to continue while a server is running. A snapshot taken then would be
# of a database being written to, and `bin/reset` restoring it afterwards would
# put back a state nobody ever had.
require_stopped_servers() {
  for port in $(ports_of_servers); do
    if port_in_use "$port"; then
      fail "A server is running on port $port (http://127.0.0.1:$port/). Stop it (Ctrl+C on the terminal that started it) and run this command again: saving or restoring the environment while the server runs would save a database that is being written to."
    fi
  done
}

# The same names of `excluded`, as the arguments that tar expects.
tar_excludes() {
  for name in $excluded; do
    printf -- '--exclude=%s ' "$name"
  done
}

# The moment of the snapshot, in a readable way. The file keeps the ISO 8601
# format, which is what `date` writes and what any other tool can read.
snapshot_date() {
  cut -c 1-16 "$directory/created_at" | tr 'T' '@' | sed 's/@/ at /'
}

force=false

for argument in "$@"; do
  case "$argument" in
    -f | --force) force=true ;;
    -h | --help) usage; exit 0 ;;
    *) printf 'Error: invalid usage: %s\n' "$argument" >&2; exit 2 ;;
  esac
done

command -v curl > /dev/null 2>&1 ||
  fail "curl not found. It is what the command uses to find out whether a server is running."

require_stopped_servers

if [ -d "$directory" ] && [ -f "$directory/created_at" ] && [ "$force" = false ]; then
  printf '\nThere is already a snapshot in %s/, saved at %s. Nothing was changed.\n' \
    "$directory" "$(snapshot_date)"
  printf 'Use --force to replace it.\n'

  exit 0
fi

step "Saving the snapshot ($directory/)"

# The copy is made with tar, which is what carries the folders and the
# permissions of the environment from one system to another.
#
# It only happens with the server stopped, and that is not a formality: while
# the server runs, the SQLite files are open and can change between the moment
# they are read and the moment they are written, and the result is a snapshot of
# a database that never existed - half of a transaction, a table that does not
# match its rows. A database nobody writes to is not changing under the copy,
# which is what makes the snapshot consistent.
rm -rf "$directory"
mkdir -p "$directory" ||
  fail "Could not prepare $directory. Check the permissions of the folder."

tar $(tar_excludes) -cf - . | tar -xf - -C "$directory" ||
  fail "Could not save the snapshot. On Windows, close the server and the editor before running the command."

# Written last, because its presence is what tells that the snapshot finished
# being saved. It sits beside the copy as metadata of the snapshot, and
# `bin/reset` leaves it out of the restore.
date +%Y-%m-%dT%H:%M:%S%z > "$directory/created_at" ||
  fail "Could not save the moment of the snapshot."

printf '    Whole environment saved (%s).\n' "$(snapshot_date)"