# Environment variables for the ruby-sinatra server (Ruby / Sinatra).
# Copy this file to `.env` and adjust the values if needed.

# Runtime environment: development (default), test or production.
APP_ENV=development

# Port of the development server, started by `bin/start`. It must stay on the
# loopback interface (127.0.0.1): this API has no authentication.
# PORT=9292

# Port of the server the end-to-end tests start, kept apart from the one above.
# E2E_PORT=9393

# The database connection is configured in data/database.yml.