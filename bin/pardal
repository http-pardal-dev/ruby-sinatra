#!/usr/bin/env ruby
# frozen_string_literal: true

# Executable of the ruby-sinatra educational server.
#
# It prepares the runtime and hands the arguments to the CLI in lib/.
# The commands themselves live in `lib/pardal/`.

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

# The launcher comes first: it activates the bundle and installs the gems when
# they are missing, which is what lets `setup` run on a fresh clone.
require "pardal/launcher"

Pardal::Launcher.new.boot

require "pardal"

Pardal::Cli::Runner.start(ARGV)
