# Environment variables for the ruby-sinatra server (Ruby / Sinatra).
# Copy this file to `.env` and adjust the values if needed.

# Runtime environment: development (default), test or production.
APP_ENV=development

# Port of the server. It must stay on the loopback interface (127.0.0.1):
# this API has no authentication.
# PORT=9292

# The database connection is configured in data/database.yml.