#!/usr/bin/env ruby
# frozen_string_literal: true

# Executable of the ruby-sinatra educational server.
#
# It only prepares the runtime and hands the arguments to the CLI in lib/.
# The commands themselves live in `lib/pardal/`.

# The CLI needs less than the application: see config/cli.rb.
require_relative "../config/cli"

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))
require "pardal"

Pardal::Cli::Runner.start(ARGV)
