#!/usr/bin/env sh
#
# test - runs the end-to-end tests.
#
# The examples live in test/e2e/*.sh and talk with a real server, so the
# command starts one (in the `test` environment, on port 9292), waits until it
# answers, runs the examples and stops the server at the end. Port 9292 has to
# be free: the command refuses to start when something is already listening
# there, which keeps the examples from reaching another server (and the
# development database) by mistake.
#
# Exit codes: 0 success, 1 error while running or failed examples, 2 invalid
# usage.

set -e

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

usage() {
  cat <<EOF
Usage: bin/test [options]

Runs the end-to-end tests (test/e2e/*.sh).

The command starts the server in the test environment, waits until it answers,
runs every example and stops the server at the end. Port 9292 must be free.

Options:
  -h, --help   Shows this message

Run bin/help to see the commands.
EOF
}

fail() {
  printf 'Error: %s\n' "$1" >&2
  exit 1
}

step() {
  printf '\n==> %s\n' "$1"
}

for argument in "$@"; do
  case "$argument" in
    -h | --help) usage; exit 0 ;;
    *) printf 'Error: invalid usage: %s\n' "$argument" >&2; exit 2 ;;
  esac
done

command -v curl > /dev/null 2>&1 || fail "curl not found."
bundle check > /dev/null 2>&1 ||
  fail "The dependencies are not installed. Run bin/setup to prepare the environment."

# A leftover `bin/start` on the port would answer the examples with the
# development database, so the tests only run when 9292 is free. The URL is
# `localhost` (not 127.0.0.1) because Puma listens on `[::]`, the IPv6 side.
if curl -s -o /dev/null --max-time 2 "http://localhost:9292/" 2>/dev/null; then
  fail "Port 9292 is already in use. Stop the other server and run bin/test again."
fi

server_pid=""
log_file=$(mktemp "${TMPDIR:-/tmp}/pardal_puma.XXXXXX")
summary_file=$(mktemp "${TMPDIR:-/tmp}/pardal_tests.XXXXXX")
E2E_SUMMARY_FILE=$summary_file
export E2E_SUMMARY_FILE

stop_server() {
  [ -n "$server_pid" ] || return 0

  kill "$server_pid" 2>/dev/null || true

  waited=0
  while kill -0 "$server_pid" 2>/dev/null; do
    waited=$((waited + 1))
    if [ "$waited" -ge 30 ]; then
      kill -9 "$server_pid" 2>/dev/null || true
      break
    fi
    sleep 0.2
  done

  wait "$server_pid" 2>/dev/null || true
  server_pid=""
}

cleanup() {
  stop_server
  rm -f "$log_file" "$summary_file"
}

trap 'cleanup' 0
trap 'exit 1' 1 2 15

step "Starting the server (test environment, http://localhost:9292)"

APP_ENV=test bundle exec puma config.ru > "$log_file" 2>&1 &
server_pid=$!

# Waits until the server answers, so the first `curl` never races the boot.
waited=0
until curl -s -o /dev/null --max-time 2 "http://localhost:9292/" 2>/dev/null; do
  if ! kill -0 "$server_pid" 2>/dev/null; then
    tail -20 "$log_file" >&2
    fail "The server exited during the boot."
  fi

  waited=$((waited + 1))
  if [ "$waited" -ge 100 ]; then
    tail -20 "$log_file" >&2
    fail "The server did not answer in time."
  fi

  sleep 0.3
done

printf '    Server ready.\n'

step "Running the examples (test/e2e)"

run_status=0
for name in users products payments; do
  if ! sh "test/e2e/$name.sh"; then
    run_status=1
  fi
done

totals=$(awk '{ e = e + $1; f = f + $2 } END { print e + 0, f + 0 }' "$summary_file")
total_failures=${totals#* }
total_examples=${totals%% *}

printf '\n%s examples, %s failures\n' "$total_examples" "$total_failures"

if [ "$run_status" -ne 0 ] || [ "$total_failures" -ne 0 ]; then
  exit 1
fi
