#!/usr/bin/env sh
#
# setup - prepares the environment of the server.
#
# The command says what the server has to do. How it is done is written by the
# implementation of this server and nowhere else: the steps below are Ruby,
# Bundler, SQLite and rake, but the command itself - "prepare the environment" -
# is the same on every server of the project.
#
# The steps are idempotent: running the command twice cannot break an
# environment that is already ready.
#
# Exit codes: 0 success, 1 error while running, 2 invalid usage.

set -e

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

usage() {
  cat <<EOF
Usage: bin/setup [options]

Prepares the environment of the server.

Options:
      --install        Installs the dependencies even when they are already in place
      --skip-install   Does not check nor install the dependencies
  -h, --help           Shows this message

Run bin/help to see the commands.
EOF
}

fail() {
  printf 'Error: %s\n' "$1" >&2
  exit 1
}

step() {
  printf '\n==> %s\n' "$1"
}

install=false
skip_install=false

for argument in "$@"; do
  case "$argument" in
    --install) install=true ;;
    --skip-install) skip_install=true ;;
    -h | --help) usage; exit 0 ;;
    *) printf 'Error: invalid usage: %s\n' "$argument" >&2; exit 2 ;;
  esac
done

if [ "$install" = true ] && [ "$skip_install" = true ]; then
  printf 'Error: --install and --skip-install cannot be used together\n' >&2
  exit 2
fi

# Compares two dotted versions ("4.0.5" and "3.2"). `awk` is the only way of
# doing it that does not depend on the version of `sort`.
version_is_at_least() {
  awk -v installed="$1" -v minimum="$2" 'BEGIN {
    left = split(installed, current, ".")
    right = split(minimum, required, ".")
    for (position = 1; position <= (left > right ? left : right); position++) {
      installed_part = (position <= left ? current[position] : 0) + 0
      required_part = (position <= right ? required[position] : 0) + 0
      if (installed_part != required_part) exit (installed_part > required_part ? 0 : 1)
    }
    exit 0
  }'
}

# 1. The Ruby version. The Gemfile is the only source of the rule, so it does
#    not need to be repeated here.
step "Checking the Ruby version"

command -v ruby > /dev/null 2>&1 ||
  fail "Ruby not found. Install it and make sure it is in the PATH: https://www.ruby-lang.org/en/downloads/"

# The Ruby installed, as `ruby -v` reports it: "ruby 4.0.5 (2026-05-20 ...)".
installed=$(ruby -v | awk '{ print $2 }')
required=$(sed -n 's/^[[:space:]]*ruby[[:space:]]*"\(.*\)"/\1/p' Gemfile)
[ -n "$required" ] || required=">= 3.2"

version_is_at_least "$installed" "${required#>= }" ||
  fail "Ruby $installed installed, but the project requires $required (Gemfile). Install a compatible version: https://www.ruby-lang.org/en/downloads/"

# 2. The dependencies, only when they are missing. The installation itself
#    belongs to `bin/install`, the command that knows how to do it: this one
#    only decides when it is needed. `--skip-install` skips the check and the
#    installation and `--install` always installs.
if [ "$skip_install" = false ]; then
  command -v bundle > /dev/null 2>&1 ||
    fail "Bundler not found. Install it with: gem install bundler"

  if [ "$install" = true ] || ! bundle check > /dev/null 2>&1; then
    sh "$root/bin/install"
  else
    step "Checking the dependencies"
    printf '    The dependencies are already installed.\n'
  fi
fi

# 3. The local configuration, copied from the example when it does not exist.
step "Preparing the local configuration (.env)"

[ -f .env.example ] || fail "File .env.example not found in $root."

if [ -f .env ]; then
  printf '    .env already exists and was kept.\n'
else
  cp .env.example .env
  printf '    .env created from .env.example.\n'
fi

# 4. The folder where the databases live.
step "Preparing the databases directory (storage/)"

if [ -d storage ]; then
  printf '    storage/ already exists.\n'
else
  mkdir -p storage
  printf '    storage/ created.\n'
fi

# 5. The tables, one environment at a time.
for environment in development test; do
  step "Creating the tables of the $environment database (db:migrate)"

  APP_ENV="$environment" bundle exec rake db:migrate ||
    fail "\`rake db:migrate\` failed for the $environment environment. Review the migrations in db/migrate."
done

# 6. The first snapshot, saved when there is none. From then on it belongs to
#    the user, who can replace it with `bin/snapshot --force`.
if [ -d .snapshot ] && [ -f .snapshot/created_at ]; then
  step "Keeping the snapshot (.snapshot/)"
  printf '    The snapshot of %s was kept.\n' "$(cut -c 1-16 .snapshot/created_at | tr 'T' '@' | sed 's/@/ at /')"
else
  # The snapshot is saved by the command that knows how to save it, and this
  # one only decides when it is needed.
  sh "$root/bin/snapshot"
  printf '    Whole environment saved for the reset command.\n'
fi

printf '\nEnvironment ready.\n'